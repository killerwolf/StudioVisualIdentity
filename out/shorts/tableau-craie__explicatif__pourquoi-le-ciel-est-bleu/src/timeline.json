    {"text": "= toutes les couleurs", "role": "body", "y": 1250, "color": "#FFB84C", "t0": 3.1, "t1": 5.1},

    {"text": "le bleu rebondit partout !", "role": "body", "y": 520, "color": "#7FD1FF", "t0": 7.3, "t1": 9.15},
    {"text": "molécule d'air", "role": "caption", "y": 1112, "color": "#F7F3E3", "t0": 5.7, "t1": 9.15},
    {"text": "le rouge passe tout droit", "role": "caption", "y": 1250, "color": "#FF7A7A", "t0": 6.4, "t1": 9.15},

