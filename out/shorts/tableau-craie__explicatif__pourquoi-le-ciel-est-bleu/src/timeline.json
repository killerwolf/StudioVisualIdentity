  "texts": [
    {"text": "Pourquoi le ciel", "role": "display", "y": 250, "t0": 0.0, "t1": 5.15, "fade": 0.15},
    {"text": "est bleu ?", "role": "display", "y": 372, "color": "#7FD1FF", "t0": 0.0, "t1": 5.15, "fade": 0.15},
