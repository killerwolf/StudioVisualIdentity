{
  "id": "liquid-chrome",
  "name": "Chrome Liquide",
  "version": "1.0.0",
  "color": {
    "bg": "#0B0B10",
    "surface": "#1A1A24",
    "accent": ["#C8D3FF", "#FF9AE8", "#7CF7E4", "#FFE29A"],
    "accentNames": ["lilas chrome", "rose", "menthe", "or"],
    "text": "#FFFFFF",
    "muted": "#C8D3FF",
    "success": "#7CF7E4",
    "danger": "#FF9AE8",
    "gradient": "linear-gradient(90deg,#C8D3FF,#FF9AE8 45%,#7CF7E4 80%,#FFE29A)",
    "halos": [{"color": "#FF9AE8", "alpha": 0.16}, {"color": "#7CF7E4", "alpha": 0.12}, {"color": "#C8D3FF", "alpha": 0.10}]
  },
  "typography": {
    "display": {"family": "Syne", "pkg": "@fontsource/syne", "weight": 800, "size": 92, "lineHeight": 1.0, "tracking": "-0.03em"},
    "title": {"family": "Syne", "pkg": "@fontsource/syne", "weight": 800, "size": 76, "lineHeight": 1.0, "tracking": "0", "use": "chiffres / numéros de couloir"},
    "body": {"family": "Inter", "pkg": "@fontsource/inter", "weight": 500, "size": 60, "tracking": "-0.01em", "use": "CTA (pilule menthe, texte #0B0B10)"},
    "caption": {"family": "Inter", "pkg": "@fontsource/inter", "weight": 500, "size": 54, "tracking": "0.2em", "case": "uppercase", "color": "#C8D3FF"},
    "data": {"family": "Inter", "pkg": "@fontsource/inter", "weight": 600, "size": 54, "tracking": "-0.02em", "use": "pourcentages flottants"},
    "layout": {"x": 72, "captionY": 232, "titleY": 306, "maxCharsPerLineAt92": 11}
  },
  "motion": {
    "easing": {"enter": "outCubic", "exit": "linear", "emphasis": "outBack"},
    "duration": {"fast": 0.35, "base": 0.45, "slow": 0.6},
    "stagger": 1.55,
    "slowMotion": 0.5,
    "hookDeadline": 0.3,
    "rules": ["plan-séquence unique, pas de coupe", "la matière bouge dès la frame 0", "ralenti ×0,5 avant la chute", "jamais de rebond cartoon ni de shake"]
  },
  "camera": {
    "fov": 30,
    "moves": ["plan fixe macro (2D, Taichi)", "dérive latérale sin(0.05 t) × 0.25 u", "travelling avant 0.5 u sur toute la durée (inOutSine)", "glissement vers le sujet gagnant après la chute (outCubic 0.6 s)"],
    "dof": {"pass": "BokehPass", "focus": "distance caméra-sujet", "aperture": 0.0022, "maxblur": 0.008}
  },
  "transitions": [
    {"name": "fondu-chrome", "ffmpegXfade": "fade", "duration": 0.45, "use": "entrée/sortie des titres (overlays alpha, assemble.py --overlay …:0.45)"},
    {"name": "glisse-haut", "ffmpegXfade": "slideup", "duration": 0.6, "use": "titre de résultat et CTA qui montent de 30–40 px"},
    {"name": "dissolution-lente", "ffmpegXfade": "dissolve", "duration": 0.8, "use": "seulement si deux plans doivent s'enchaîner (les shorts de preuve sont des plans uniques)"}
  ],
  "safeArea": {"top": 220, "bottom": 320, "right": 120},
  "render": {
    "env": "PMREM procédural : sphère sombre + panneaux néon (#C8D3FF haut, #FF9AE8 gauche, #7CF7E4 droite, #FFE29A bas, blanc clé)",
    "chromeMaterial": {"metalness": 1, "roughness": 0.06, "iridescence": 0.35, "iridescenceIOR": 1.6, "clearcoat": 1},
    "liquidMaterial": {"metalness": 0.85, "roughness": 0.14, "iridescence": 0.45, "clearcoat": 1},
    "mpm": {"grid": [90, 196], "dx": 0.00625, "dt": 0.0001, "substeps": 80, "E": 600, "mu": 0.05, "particles": 24000}
  },
  "libraries": ["Taichi", "OpenCV", "three.js"]
}
