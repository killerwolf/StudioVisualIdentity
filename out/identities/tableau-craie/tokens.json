{
  "id": "tableau-craie",
  "name": "Tableau Craie",
  "version": "1.0.0",
  "color": {
    "bg": "#1F3A30",
    "surface": "#264639",
    "accent": ["#FFF6D5", "#FFB84C", "#7FD1FF", "#FF7A7A"],
    "text": "#F7F3E3",
    "muted": "#A9BFAF",
    "success": "#9BE58A",
    "danger": "#FF7A7A"
  },
  "typography": {
    "display": {"family": "Nunito", "pkg": "nunito", "weight": 800, "size": 108, "tracking": -1},
    "title": {"family": "Nunito", "pkg": "nunito", "weight": 800, "size": 92, "tracking": -1},
    "body": {"family": "Caveat", "pkg": "caveat", "weight": 700, "size": 72, "tracking": 0},
    "caption": {"family": "Caveat", "pkg": "caveat", "weight": 700, "size": 60, "tracking": 0}
  },
  "motion": {
    "easing": {"enter": "outCubic (craie qui se pose) / Create linéaire-sinus pour les tracés", "exit": "inOutSine (chiffon)", "emphasis": "outBack (pop des chiffres et des feuilles)"},
    "duration": {"fast": 0.35, "base": 0.8, "slow": 1.6},
    "stagger": 0.12,
    "hookDeadline": 0.8
  },
  "camera": {"fov": "2D frontale fixe (orthographique)", "moves": ["zoom lent 1.0→1.12 sur le détail expliqué (inOutSine, 2–3 s)", "retour 1.0 pendant le chiffon"], "dof": "aucune (tableau plat, tout net)"},
  "transitions": [
    {"name": "chiffon", "ffmpegXfade": "smoothleft", "duration": 0.6, "use": "entre deux idées : un chiffon balaie de gauche à droite, les tracés s'effacent dans l'ordre du balayage, une trace de craie reste"},
    {"name": "craie-qui-se-pose", "ffmpegXfade": "fade", "duration": 0.25, "use": "apparition d'un mot-clé (fondu court + grain)"}
  ],
  "safeArea": {"top": 220, "bottom": 320, "right": 120},
  "libraries": ["Manim", "Rough.js", "GSAP"]
}
