{
  "id": "pixel-arcade",
  "name": "Arcade Pixel",
  "version": "1.1.0",
  "color": {
    "bg": "#0E0B1F",
    "surface": "#1D1740",
    "accent": [
      "#FF4F79",
      "#3CF2A0",
      "#FFD23F",
      "#4FB3FF"
    ],
    "text": "#FFFFFF",
    "muted": "#8A7FD6",
    "success": "#3CF2A0",
    "danger": "#FF4F79",
    "grid": "#16123A",
    "stars": "#2A2358",
    "shadow": "#000000"
  },
  "typography": {
    "display": {
      "family": "Rubik Mono One",
      "pkg": "rubik-mono-one",
      "weight": 400,
      "size": 120,
      "tracking": "-0.02em",
      "lineHeight": 1.05,
      "shadow": "10px 10px 0 #000 (carte de fin) / 8px 8px 0 accent rose (titres)"
    },
    "title": {
      "family": "Rubik Mono One",
      "pkg": "rubik-mono-one",
      "weight": 400,
      "size": 104,
      "sizeLongTitle": 80,
      "tracking": "-0.02em",
      "lineHeight": 1.08
    },
    "body": {
      "family": "Press Start 2P",
      "pkg": "press-start-2p",
      "weight": 400,
      "size": 56,
      "tracking": "0",
      "lineHeight": 80
    },
    "caption": {
      "family": "Press Start 2P",
      "pkg": "press-start-2p",
      "weight": 400,
      "size": 56,
      "tracking": "0",
      "use": "HUD (TIME, REBONDS), classement"
    },
    "countdown": {
      "family": "Rubik Mono One",
      "weight": 400,
      "size": 240,
      "shadow": "12px 12px 0 #FF4F79"
    }
  },
  "grid": {
    "logical": [
      270,
      480
    ],
    "upscale": 4,
    "filter": "nearest (image-rendering: pixelated)",
    "quantum": "4 px écran = 1 pixel logique",
    "scanlines": "repeating-linear-gradient 2px noir 20 % / 4px"
  },
  "motion": {
    "easing": {
      "enter": "steps(6) — paliers discrets, jamais d'interpolation douce",
      "exit": "steps(6) — sortie du titre : translateX en 6 paliers de 8 px quantifiés sur 0,4 s",
      "emphasis": "pop-scale 1.4 -> 1.2 -> 1.0 en 3 paliers de 2 frames (compte à rebours) + clignotement 4 Hz"
    },
    "duration": {
      "fast": 0.07,
      "base": 0.4,
      "slow": 0.6
    },
    "stagger": 0.12,
    "blink": {
      "hz": 4,
      "bannerIntroHz": 12,
      "bannerIntro": 0.3
    },
    "screenshake": {
      "amplitudePx": [
        4,
        8,
        12
      ],
      "frames": [
        2,
        4,
        6
      ],
      "step": "4 px, alterné gauche/droite chaque frame"
    },
    "physics": {
      "fps": 30,
      "matterSubsteps": 4,
      "matterDtMs": 8.333,
      "ringSubsteps": 8,
      "conquestSubsteps": 2
    },
    "hookDeadline": 1.0
  },
  "camera": {
    "fov": null,
    "projection": "2D orthographique fixe",
    "moves": [
      "fixe plein cadre",
      "screenshake quantifié sur impact"
    ],
    "dof": "aucune"
  },
  "transitions": [
    {
      "name": "pixel-mosaic",
      "ffmpegXfade": "pixelize",
      "duration": 0.6,
      "use": "jeu -> carte de fin : blocs 1,2,4,8,16 px logiques puis retour (10 paliers), coupe au milieu"
    },
    {
      "name": "step-slide-out",
      "ffmpegXfade": "slideleft",
      "duration": 0.4,
      "use": "sortie du panneau-titre au top départ (6 paliers)"
    },
    {
      "name": "blink-in",
      "ffmpegXfade": "fadefast",
      "duration": 0.3,
      "use": "entrée des bannières (PHOTO FINISH, ÉVADÉE) : clignotement 12 Hz puis fixe"
    }
  ],
  "sound": {
    "preset": "chiptune",
    "bpm": 125,
    "sfx": [
      "coin (hook, arrivée n°1, carte de fin)",
      "blip (collision / rebond, hauteur = couleur ou rang)",
      "whoosh (pixel-mosaic)",
      "chime (bannière)"
    ],
    "musicGain": 0.36
  },
  "safeArea": {
    "top": 220,
    "bottom": 320,
    "right": 120,
    "left": 60
  },
  "libraries": [
    "Matter.js",
    "p5.js",
    "PixiJS"
  ]
}