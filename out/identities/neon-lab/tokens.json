{
 "id": "neon-lab",
 "name": "Labo Néon",
 "version": "1.0.0",
 "color": {
  "bg": "#05060B",
  "surface": "#11142A",
  "accent": [
   "#38F9FF",
   "#FF3DCB",
   "#B6FF3B"
  ],
  "text": "#F2F6FF",
  "muted": "#9FB7FF",
  "success": "#B6FF3B",
  "danger": "#FF3DCB",
  "roles": {
   "accent1_cyan": "sujet principal, lignes d'orbite, chiffres-clés du titre",
   "accent2_magenta": "contre-exemple / danger, pastille du tag LABO",
   "accent3_lime": "donnée vérifiée, résultat, paramètres (σ ρ β, 27,3 j)",
   "fieldLines": "cyan↔magenta à 10 % d'opacité (+14 % sur impulsion)"
  }
 },
 "typography": {
  "display": {
   "family": "Space Grotesk",
   "pkg": "@fontsource/space-grotesk",
   "weight": 700,
   "size": 118,
   "tracking": "-0.035em",
   "lineHeight": 0.96
  },
  "title": {
   "family": "Space Grotesk",
   "pkg": "@fontsource/space-grotesk",
   "weight": 700,
   "size": 100,
   "tracking": "-0.035em",
   "lineHeight": 0.98,
   "sizeAlt": 112
  },
  "body": {
   "family": "Space Grotesk",
   "pkg": "@fontsource/space-grotesk",
   "weight": 500,
   "size": 56,
   "tracking": "-0.01em",
   "lineHeight": 1.16
  },
  "caption": {
   "family": "JetBrains Mono",
   "pkg": "@fontsource/jetbrains-mono",
   "weight": 500,
   "size": 54,
   "tracking": "0.01em",
   "use": "tag LABO/0X, données, légendes"
  }
 },
 "motion": {
  "easing": {
   "enter": "outExpo",
   "exit": "inExpo",
   "emphasis": "pulse exp(-Δt/0.35) sur bloom/halo",
   "camera": "inOutSine"
  },
  "duration": {
   "fast": 0.3,
   "base": 0.6,
   "slow": 2.4
  },
  "stagger": 0.8,
  "hookDeadline": 0.1,
  "beat": {
   "bpm": 80,
   "quarter": 0.75,
   "pulseEvery": 1.5
  },
  "glideDistancePx": 46
 },
 "camera": {
  "fov": 38,
  "moves": [
   "dolly-in outExpo 2,4 s au hook",
   "orbite lente ±15° (inOutSine ou sinus périodique pour les boucles)",
   "poussée finale -0,9 u inOutSine"
  ],
  "elevationDeg": 38,
  "dof": "aucune DoF optique ; profondeur par brouillard exponentiel (0,022) + bloom + vignette OpenCV"
 },
 "transitions": [
  {
   "name": "pulse-flash",
   "ffmpegXfade": "fadewhite",
   "duration": 0.35,
   "use": "in-scene à chaque changement de beat : bloom 0,62→1,52 décroissant exp(0,35 s) + lignes de champ +14 % ; équivalent ffmpeg fadewhite si assemblage de clips"
  },
  {
   "name": "glide",
   "ffmpegXfade": "slideup",
   "duration": 0.6,
   "use": "entrée des titres/données : translateY 46 px + opacité, outExpo ; sortie inExpo 0,3 s"
  },
  {
   "name": "loop-seam",
   "ffmpegXfade": "none",
   "duration": 0,
   "use": "abstrait : pas de transition, la couture tombe sur une impulsion (frame T = frame 0)"
  }
 ],
 "safeArea": {
  "top": 220,
  "bottom": 320,
  "right": 120,
  "left": 72
 },
 "layout": {
  "tagTop": 232,
  "titleTop": 316,
  "sceneBand": [
   580,
   1340
  ],
  "dataTop": 1380,
  "marginLeft": 72
 },
 "post": {
  "tool": "OpenCV neon_grade.py",
  "glow": 0.55,
  "glowThreshold": 0.42,
  "chromaticAberration": 0.0022,
  "vignette": 0.22
 },
 "field": {
  "shader": "field.glsl.js neonField()",
  "isoLines": 11,
  "noise": "fbm 3 octaves + puits radial 0.42/(5.5r+1)"
 },
 "libraries": [
  "three.js",
  "twgl.js",
  "OpenCV"
 ]
}