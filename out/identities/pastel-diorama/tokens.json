{
  "id": "pastel-diorama",
  "name": "Diorama Pastel",
  "version": "1.0.0",
  "color": {
    "bg": "#FFE8EF",
    "bgGradient": "radial-gradient(900px 1100px at 50% 55%, #FFF4F7 0%, #FFE8EF 60%, #FFDCE7 100%) + points #FFC9D8 3px / pas 46px, opacité 0.55",
    "surface": "#FFFFFF",
    "accent": ["#FF8FAB", "#8ED6FF", "#FFD670", "#9BE7B0"],
    "accentInk": "#E23D72",
    "linkInk": "#2F7FB5",
    "character": { "goutte": "#6EC3F5", "renard": "#FF9E5E", "joues": "#FF8FAB", "nuagePluie": "#C9D3EE" },
    "text": "#3B2E5A",
    "muted": "#F9C6D5",
    "success": "#9BE7B0",
    "danger": "#E23D72",
    "shadow": { "card": "0 14px 0 #F9C6D5, 0 30px 60px rgba(59,46,90,.12)", "pill": "0 8px 0 rgba(59,46,90,.14)", "title": "0 8px 0 #FFC2D3" }
  },
  "typography": {
    "display": { "family": "Baloo 2", "pkg": "@fontsource/baloo-2", "weight": 800, "size": 132, "lineHeight": 1.0, "tracking": "-0.01em" },
    "title": { "family": "Baloo 2", "pkg": "@fontsource/baloo-2", "weight": 800, "size": 96, "lineHeight": 1.0, "tracking": "0" },
    "body": { "family": "Nunito", "pkg": "@fontsource/nunito", "weight": 800, "size": 60, "lineHeight": 1.15, "tracking": "0" },
    "caption": { "family": "Nunito", "pkg": "@fontsource/nunito", "weight": 800, "size": 56, "lineHeight": 1.0, "tracking": "0" },
    "number": { "family": "Baloo 2", "pkg": "@fontsource/baloo-2", "weight": 800, "size": 84, "countdownSize": 190 }
  },
  "motion": {
    "easing": {
      "enter": "back.out(1.8)",
      "exit": "back.in(1.6)",
      "emphasis": "elastic.out(1,0.35)",
      "landing": "bounce.out",
      "travel": "power1.inOut / sine.inOut",
      "fall": "power2.in"
    },
    "duration": { "fast": 0.3, "base": 0.5, "slow": 1.3 },
    "stagger": 0.16,
    "idle": { "float": "sin(t*3.1)*8px (personnage)", "cloudBob": "sin(t*1.6)*10px", "breath": "squash 1±0.05 à 3 rad/s" },
    "hookDeadline": 0.3
  },
  "camera": {
    "fov": 30,
    "zdogTilt": "rotate.x = -TAU/13 (≈ -27.7°), rotate.y = TAU/9 ± 0.12 rad (sin t*0.45)",
    "aframe": "élévation ≈ 25°, distance ≈ 13 m, lookAt Matrix4, travelling latéral ±0.7 m (sin t*0.45), push-in 13 % pendant le choix",
    "moves": ["travelling latéral de maquette (sinus lent 0.45 rad/s)", "push-in doux 13 % sur le moment clé", "pas de coupe, plan-séquence"],
    "dof": "aucune (tout net, comme une maquette photographiée)"
  },
  "transitions": [
    { "name": "pastille-pop", "ffmpegXfade": "fade", "duration": 0.3, "use": "changement d'étape : la pastille sort en back.in 0.3 s, la suivante entre en back.out 0.5 s (in-scene ; fade 0.3 s si clips séparés)" },
    { "name": "teinte-ciel", "ffmpegXfade": "fadewhite", "duration": 1.4, "use": "changement d'ambiance (froid, altitude) : dégradé bleu #DDEBFF en fondu sur le fond rose" },
    { "name": "couvercle-pop", "ffmpegXfade": "circleopen", "duration": 0.5, "use": "révélation : couvercle/rideau qui saute en back.out + confettis ; circleopen si la révélation est un clip séparé" }
  ],
  "safeArea": { "top": 220, "bottom": 320, "right": 120, "left": 60 },
  "sound": { "preset": "music-box", "key": "F", "scale": "majpent", "bpm": 96, "signature": ["pop C6/F6 à chaque entrée", "chime à chaque étape", "glass pour la magie", "coin+chime à la révélation"] },
  "libraries": ["Zdog", "GSAP", "A-Frame"]
}
